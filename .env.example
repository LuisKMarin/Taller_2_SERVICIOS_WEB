# Copia este archivo como .env y completa los valores.
# No subas el .env al repositorio (esta en el .gitignore).

# PostgreSQL (datos suministrados por el docente)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Broker MQTT
MQTT_BROKER=emqx.coriotlab.co
MQTT_PORT=1883
MQTT_TOPIC=iot/sensors/GAS-005/data
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# Sensor asignado al grupo
SENSOR_CODIGO=GAS-005
